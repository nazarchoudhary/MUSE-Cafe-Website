[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/nazarchoudhary/MUSE-Cafe-Website.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "feature/contact-page"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/feature/contact-page
[branch "feature/menu-specials"]
	vscode-merge-base = origin/feature/contact-page
	remote = origin
	merge = refs/heads/feature/menu-specials
